{
    "name": "typetrace/cli",
    "description": "Merge typetrace reports and suggest types from runtime observations",
    "type": "project",
    "license": "MIT",
    "bin": ["bin/typetrace"],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^5.0",
        "phpstan/phpdoc-parser": "^2.0",
        "symfony/console": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "Typetrace\\": "src/" } },
    "autoload-dev": { "psr-4": { "Typetrace\\Tests\\": "tests/" } },
    "config": { "sort-packages": true }
}
